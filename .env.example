# ---------------------------------------------------------------------------
# Meeting Analyzer - environment settings
#
# HOW TO USE:
#   1. Copy this file and rename the copy to ".env"
#   2. Fill in your own values below
#   3. NEVER share the .env file or commit it to source control
#      (it is already listed in .gitignore)
# ---------------------------------------------------------------------------

# ---- AI (local Ollama - no API key, nothing leaves your machine) ----------
# The /api/chat endpoint of your Ollama server.
OLLAMA_URL=http://localhost:11434/api/chat

# The model to use. Download it once with:  ollama pull qwen2.5:3b
# Leave EMPTY to run the app in offline fallback mode (basic built-in
# extraction, no AI model required).
OLLAMA_MODEL=qwen2.5:3b

# ---- Flask -----------------------------------------------------------------
# Used to sign browser sessions. Change it to any long random text.
FLASK_SECRET_KEY=change-this-to-a-long-random-string

# ---- Limits ----------------------------------------------------------------
# Maximum size of an uploaded TXT / PDF / DOCX file, in megabytes.
MAX_FILE_SIZE_MB=5

# Maximum size of an uploaded audio recording (mp3 / wav / m4a / ...).
MAX_AUDIO_MB=50

# ---- Audio transcription (optional) ----------------------------------------
# Whisper model for speech-to-text: tiny (fastest), base, small, medium.
# Only used after:  pip install -r requirements-audio.txt
# (The Settings page overrides this default when you save a value there.)
WHISPER_MODEL=base
